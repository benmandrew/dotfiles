# Login shells only. Homebrew, Nix and elan all want to be on PATH before
# .zshrc runs, since .zshrc reads $HOMEBREW_BASE and ~/.fzf.zsh sources out of
# the keg — a Mac provisioned from the install scripts with neither of these
# files managed came up with no brew on PATH at all.

# Nix. The installer writes this same block into /etc/zshrc, which is
# root-owned and replaced wholesale by a macOS update: this machine's
# /etc/zshrc came back byte-identical to the /etc/zshrc.backup-before-nix the
# installer had left beside it, so nothing put `nix` or ~/.nix-profile/bin on
# PATH any more. /etc/bashrc kept its copy, which is why only zsh lost it.
# The profile directory held the bash 5.3 that `install_modern_bash` puts
# there, so losing it dropped direnv back to /bin/bash 3.2.57, under the 4.4
# that nix-direnv's `use flake` requires, and every .envrc in a flake
# repository, this one included, stopped loading.
#
# Sourced ahead of the blocks below, so Homebrew keeps the front of PATH and
# the ~/.local/bin entries in .zshrc keep the front of that. The profile holds
# bash, bashbug and an `sh` symlink; /bin/sh on macOS is bash 3.2 in POSIX
# mode, so shadowing it with bash 5.3 in POSIX mode takes nothing away.
# nix-daemon.sh exports __ETC_PROFILE_NIX_SOURCED and returns early on a second
# run, so a restored /etc/zshrc block costs nothing rather than prepending a
# second copy. The second path covers a single-user install, which has no
# /nix/var/nix/profiles/default.
for _nix_profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    if [ -r "$_nix_profile" ]; then
        . "$_nix_profile"
        break
    fi
done
unset _nix_profile

{{ if eq .chezmoi.os "darwin" -}}
# `brew shellenv` sets PATH, MANPATH, INFOPATH and the HOMEBREW_* variables.
# The path is fixed on Apple silicon, and this repo targets no Intel Mac.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else if eq .chezmoi.os "linux" }}
# Linuxbrew installs to /home/linuxbrew/.linuxbrew as a shared install and to
# ~/.linuxbrew when it has no write access there. Neither is guaranteed to
# exist, and most of these machines get their tools from the install scripts
# instead, so both are guarded and a miss is silent.
for _brew in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [ -x "$_brew" ]; then
        eval "$("$_brew" shellenv)"
        break
    fi
done
unset _brew
{{- end }}

# Lean's toolchain manager. Guarded on the directory, so a machine without lean
# does not carry a PATH entry that resolves to nothing.
[ -d "$HOME/.elan/bin" ] && export PATH="$HOME/.elan/bin:$PATH"

# The current opam switch's bin, so ocamllsp and dune are on PATH for an editor
# started before anything has called the `opam` shim in .zshrc, which is what
# runs `opam env`. Running `opam env` here instead costs a fork of opam on every
# login, so the switch name is read out of ~/.opam/config with builtins. A
# switch given as a path is a local one, whose prefix is <path>/_opam. The shim
# still sets the rest of `opam env` on first use, and .zshrc's typeset -U drops
# the copy of this entry it prepends.
if [ -r "$HOME/.opam/config" ]; then
    while IFS= read -r _opam_line; do
        case $_opam_line in
            'switch: '*)
                _opam_switch=${_opam_line#switch: }
                _opam_switch=${_opam_switch#\"}
                _opam_switch=${_opam_switch%\"}
                case $_opam_switch in
                    /*) _opam_bin="$_opam_switch/_opam/bin" ;;
                    *) _opam_bin="$HOME/.opam/$_opam_switch/bin" ;;
                esac
                [ -d "$_opam_bin" ] && export PATH="$_opam_bin:$PATH"
                break
                ;;
        esac
    done < "$HOME/.opam/config"
    unset _opam_line _opam_switch _opam_bin
fi
