{{- /* zdiff3 landed in git 2.35; the [merge] block below needs the version.
     Probed with a fixed PATH rather than chezmoi's own, which inside this repo
     carries direnv's flake git (2.54) and rendered zdiff3 for a machine whose
     /usr/bin/git is 22.04's 2.34. The order is the login shell's: Homebrew's
     git ahead of Apple's on macOS, and on Linux /usr/bin, where install_git
     puts the git-core PPA's. `|| true` keeps a machine without git rendering,
     with the 0.0.0 fallback. */ -}}
{{- $gitVersion := output "sh" "-c" "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin git --version 2>/dev/null || true" | regexFind `[0-9]+\.[0-9]+\.[0-9]+` | default "0.0.0" -}}
[user]
    name = benmandrew
    email = benmandrew@gmail.com
    signingkey = {{ .chezmoi.homeDir }}/.ssh/id_benmandrew
[pull]
    rebase = true
[rebase]
    # pull.rebase is on above, so without autoStash every pull on a dirty tree
    # aborts before it starts.
    autoStash = true
    autoSquash = true
    # Rebasing a base branch otherwise leaves every branch stacked on top of it
    # pointing at the old commits. gh-stack (install_gh_stack) depends on this.
    updateRefs = true
[rerere]
    # Records how a conflict was resolved and replays it when the same one
    # recurs, which rebasing a stack makes routine.
    enabled = true
    autoUpdate = true
[merge]
    # Three-way, so the common ancestor is visible alongside both sides.
    # zdiff3 needs git 2.35. An older git treats the unknown value as fatal,
    # and not only on a merge. `git merge`, `git cherry-pick` and
    # `git checkout -b` all exit 128 with "unknown style 'zdiff3' given for
    # 'merge.conflictstyle'", and `git rebase` exits 1. Ubuntu 22.04 ships
    # 2.34.1, so the value is resolved against the local git at apply time
    # and falls back to diff3.
    conflictStyle = {{ if semverCompare ">=2.35.0" $gitVersion }}zdiff3{{ else }}diff3{{ end }}
[fetch]
    # Not pruneTags: it deletes every local tag the remote lacks, including
    # ones not yet pushed.
    prune = true
[push]
    autoSetupRemote = true
    followTags = true
[branch]
    # Matches the ordering ~/.local/bin/git-bv produces by hand.
    sort = -committerdate
[tag]
    gpgsign = true
    sort = -version:refname
[column]
    ui = auto
[help]
    autocorrect = prompt
[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change
    mnemonicPrefix = true
    renames = copies
[alias]
    st = status -s --show-stash
    cm = commit -m
    # rv is ~/.local/bin/git-rv, not an alias — git runs any git-* on PATH.
    ch = checkout
    # ll is ~/.local/bin/git-ll, not an alias — git runs any git-* on PATH.
    d = diff
    sv = status -vv
    # bv is ~/.local/bin/git-bv, not an alias — git runs any git-* on PATH.
    dl = diff HEAD~1 HEAD
    # wt is ~/.local/bin/git-wt, not an alias — git runs any git-* on PATH.
[init]
    defaultBranch = main
[commit]
    gpgsign = true
    template = {{ .chezmoi.homeDir }}/.config/git/.gitmessage
    # Puts the staged diff below the template in the editor, which the template
    # asks for a body explaining.
    verbose = true
[log]
    date = iso
[core]
    excludesfile = {{ .chezmoi.homeDir }}/.config/git/.gitignore_global
    attributesFile = {{ .chezmoi.homeDir }}/.config/git/attributes
    editor = nvim
    # This key has to sit in [core]. It previously followed the [diff "prose"]
    # header below, where git read it as diff.prose.pager and ignored it: a
    # diff driver takes textconv, cachetextconv, binary, command, xfuncname
    # and wordRegex, and no pager. core.pager was therefore unset and git fell
    # back to $PAGER (dot_zshrc.tmpl:196), so `git diff`, `git log -p` and
    # `git show` rendered through bare moor and never reached delta — which is
    # why navigate and line-numbers below appeared to do nothing. `git add -p`
    # was unaffected, since interactive.diffFilter is a top-level key.
    # --paging=never stops delta spawning its own pager, which would nest
    # a second pager inside moor instead of streaming straight into it.
    # Falling back to cat matters because git runs this pipeline through sh:
    # with delta absent the shell writes "command not found" to stderr and
    # feeds moor an empty stdin, so `git diff` prints nothing at all rather
    # than failing visibly. install_delta provisions it and verify-install.sh
    # checks for it, but the pager should not be what discovers it is missing.
    # A subshell rather than a brace group: git's config parser reads ";" as a
    # start-of-comment, so the "; }" a brace group needs truncates the value.
    # moor is guarded too, since a missing pager prints nothing just the same,
    # and falls back to less. Both exec, so a non-zero exit from moor cannot
    # start less on what is left of its input; `a || b && c` groups as
    # `(a || b) && c`, and the exec in b means c never runs after it.
    pager = (command -v delta >/dev/null 2>&1 && delta --paging=never || cat) | (command -v moor >/dev/null 2>&1 || exec less -FRX && exec moor --wrap --tab-size=4 --quit-if-one-screen)
[diff "prose"]
    # One sentence per line, so a one-word edit in a paragraph-per-line file
    # stops reading as the whole paragraph replaced. Display only — git turns
    # textconv off wherever the diff has to stay applicable.
    textconv = {{ .chezmoi.homeDir }}/.local/bin/git-prose-split
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed-signers
[advice]
    addIgnoredFile = false
[credential "https://git.overleaf.com"]
    helper = "!f() { t=\"$HOME/.config/overleaf/git-token\"; test \"$1\" = get && test -f \"$t\" && printf \"password=%s\\n\" \"$(cat \"$t\")\"; }; f"
    username = git
