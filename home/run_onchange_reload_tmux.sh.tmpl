#!/bin/bash

set -euo pipefail

# Re-run this script whenever the tmux config template changes.
# chezmoi decides whether to re-run a run_onchange_ script by hashing the
# script's own rendered content, so these hash comments must stay present
# and up to date — changing either included file changes this file's body,
# which is what actually triggers the re-run.
# tmux-conf-hash: {{ include "dot_tmux.conf.tmpl" | sha256sum }}
# zshrc-conf-hash: {{ include "dot_zshrc.tmpl" | sha256sum }}

if ! command -v tmux >/dev/null 2>&1; then
    exit 0
fi

if [[ ! -f "${HOME}/.tmux.conf" ]]; then
    exit 0
fi

if tmux ls >/dev/null 2>&1; then
    tmux source-file "${HOME}/.tmux.conf"

    if [[ -f "${HOME}/.zshrc" ]]; then
        # tmux has no way to re-source a running pane's rc file directly, so
        # simulate typing the command into each zsh pane instead.
        #
        # Two things have to happen before the text is typed. A pane sitting in
        # copy mode swallows the keys as copy-mode commands, so cancel out of it
        # first. And a pane with a half-typed command line has that line in its
        # buffer: without the C-u the command is appended to whatever was
        # already there and Enter runs the pair of them. C-u is
        # kill-whole-line under zsh's emacs bindings, which is what this
        # config uses.
        while read -r pane_id pane_in_mode pane_command; do
            if [[ "${pane_command}" == "zsh" ]]; then
                if [[ "${pane_in_mode}" == "1" ]]; then
                    tmux send-keys -t "${pane_id}" -X cancel
                fi
                tmux send-keys -t "${pane_id}" C-u 'source ~/.zshrc' C-m
            fi
        done < <(tmux list-panes -a -F '#{pane_id} #{pane_in_mode} #{pane_current_command}')
    fi
fi
