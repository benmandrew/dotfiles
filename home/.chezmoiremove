# Targets to delete from the destination. Renames leave the old name behind
# otherwise, since chezmoi only ever writes what the source tree still contains.

# renamed to claude-pane-session, which also resolves the agent name
.local/bin/claude-pane-cwd

# folded into a single .config/tmux/status.sh, so tmux forks once a tick for the
# status-right metrics rather than three times
.config/tmux/cpu.sh
.config/tmux/ram.sh
.config/tmux/uptime.sh

# Every plugin's setup moved into its lazy.nvim spec, so the plugin loads on a
# key, command or event instead of at startup. nvim sources anything under
# after/plugin regardless of where it came from, so a leftover file here would
# still run: it would re-require the plugins these specs now lazy-load, undoing
# the deferral, and re-add the gi/gr maps that shadow the 0.11 builtins.
.config/nvim/after

# ai-commit-msg is gone: an open-interpreter script that asked a local Qwen
# endpoint for a commit message, superseded by the commit-message agent.
.local/bin/ai-commit-msg
