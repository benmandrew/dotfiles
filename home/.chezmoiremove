# Targets to delete from the destination. Renames leave the old name behind
# otherwise, since chezmoi only ever writes what the source tree still contains.

# renamed to claude-pane-session, which also resolves the agent name
.local/bin/claude-pane-cwd

# folded into a single .config/tmux/status.sh, so tmux forks once a tick for the
# status-right metrics rather than three times
.config/tmux/cpu.sh
.config/tmux/ram.sh
.config/tmux/uptime.sh

# Every plugin's setup moved into its lazy.nvim spec, so the plugin loads on a
# key, command or event instead of at startup. nvim sources anything under
# after/plugin regardless of where it came from, so a leftover file here would
# still run: it would re-require the plugins these specs now lazy-load, undoing
# the deferral, and re-add the gi/gr maps that shadow the 0.11 builtins.
.config/nvim/after

# ai-commit-msg is gone: an open-interpreter script that asked a local Qwen
# endpoint for a commit message, superseded by the commit-message agent.
.local/bin/ai-commit-msg

# rtk is gone: its PreToolUse hook rewrote Bash commands through a
# token-filtering proxy.
.claude/RTK.md
.claude-work/RTK.md

# WezTerm is gone: Ghostty is the terminal, with tmux doing the multiplexing.
.config/wezterm
# The idle hook kept WezTerm's name after it stopped touching WezTerm.
.claude/wezterm-notify.sh

# systemd-oomd 249 reads ManagedOOM settings from the system manager only, so
# this drop-in asking it to watch app.slice did nothing.
.config/systemd/user/app.slice.d

# zsh is gone: fish is the only shell this config sets up, and
# run_before_00-require-fish-login-shell.sh stops an apply on a machine still
# logging in to anything else. ~/.zsh_history stays, since atuin holds the
# history only on a machine that imported it.
.zshrc
.zshenv
.zprofile
.zlogin
.fzf.zsh
.zcompdump
.zcompdump.zwc
.cache/zsh
.local/share/zsh
.local/share/zinit
.local/share/zsh-nvm
.local/share/fzf-tab
.local/share/fzf-git.sh
.local/share/zsh-autosuggestions

# A .json interpreter stripped the extension from the modify_ scripts' targets,
# so they wrote these instead of settings.json.
.claude/settings
.claude-work/settings
.config/Code/User/settings
Library/Application Support/Code/User/settings
