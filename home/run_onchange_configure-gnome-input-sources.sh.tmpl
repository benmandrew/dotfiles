#!/bin/bash
# ibus-dropin-hash: {{ include "dot_config/systemd/user/org.freedesktop.IBus.session.GNOME.service.d/gb-engine.conf" | sha256sum }}

set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
# gsettings ships with glib, so it exists on any Linux box and its presence is
# not evidence of a desktop. Two things then go wrong on a headless server.
# Without a session bus every write fails to commit to dconf, and the ibus
# schemas are not installed at all, which makes `gsettings set` exit non-zero
# and -- under `set -e` -- fail the whole chezmoi run. That is not hypothetical:
# it broke a provisioning run on a server whose only fault was having glib.
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
    [ -z "${DISPLAY:-}" ] &&
    [ -z "${WAYLAND_DISPLAY:-}" ]; then
    exit 0
fi

# A schema is present only if something installed it, so check rather than
# assume: a GNOME box without ibus is a normal configuration, not an error.
has_schema() {
    gsettings list-schemas 2>/dev/null | grep -qx "$1"
}

# UK layout on every Linux box. The source list alone is not enough, since ibus
# picks its own engine from engines-order and an empty list falls back to its
# built-in default of xkb:us::eng, which the X11/XWayland keymap then follows.
# Naming gb in all three keys is still not enough either: under Wayland GNOME
# resolves an xkb-only source in mutter without telling ibus, so the daemon
# comes up on its default every login regardless of what these keys say. The
# systemd drop-in beside this script corrects that at the point ibus starts.
if has_schema org.gnome.desktop.input-sources; then
    gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'gb')]"
fi

if has_schema org.freedesktop.ibus.general; then
    gsettings set org.freedesktop.ibus.general preload-engines "['xkb:gb::eng']"
    gsettings set org.freedesktop.ibus.general engines-order "['xkb:gb::eng']"
fi

# Right Alt as the level-3 shift, which is what reaches the gb layout's
# dead-key columns and the currency symbols above them.
if has_schema org.gnome.desktop.input-sources; then
    gsettings set org.gnome.desktop.input-sources xkb-options "['lv3:ralt_switch']"
fi

# Pick up a changed drop-in. systemd reads unit files once, so without this the
# drop-in only takes effect after a reboot rather than at the next login.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
fi

# Correct a session that has already drifted, which the drop-in cannot do for
# the session it is installed from. Provisioning runs before ibus in some
# orders, so a failure here is not one worth stopping the run for.
if command -v ibus >/dev/null 2>&1; then
    ibus engine xkb:gb::eng >/dev/null 2>&1 || true
fi
{{ end -}}
