#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10,<3.13"
# dependencies = ["open-interpreter", "setuptools<81"]
# ///
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import warnings

# pkg_resources warns on import (setuptools >=81), attributed to the
# importing module (interpreter's own code) rather than to pkg_resources
# itself, so match on message text instead of module.
warnings.filterwarnings("ignore", category=UserWarning, message="pkg_resources is deprecated")

from interpreter import interpreter

interpreter.offline = True
# This script only ever prints a commit message to stdout, so the model is
# never meant to run anything. auto_run = True let open-interpreter execute
# whatever the model emitted, unprompted, in the caller's working directory —
# a staged diff that happens to contain instructions was enough to reach it.
interpreter.auto_run = False
# interpreter.llm.model = "ollama_chat/llama3.1:8b"
# interpreter.llm.model = "ollama_chat/qwen2.5-coder:7b"
interpreter.llm.model = os.environ.get("AI_COMMIT_MSG_MODEL", "ollama_chat/qwen2.5-coder:14b")
# Overridable because the default is a Tailscale address: off the tailnet the
# host is unreachable and the request blocks until the timeout below.
interpreter.llm.api_base = os.environ.get(
    "AI_COMMIT_MSG_API_BASE", "http://100.68.151.125:11434"
)
interpreter.llm.context_window = 16000
interpreter.llm.max_tokens = 3200

# Prefer AGENTS.md (symlink to CLAUDE.md) if present, else fall back to CLAUDE.md directly.
for filename in ("AGENTS.md", "CLAUDE.md"):
    path = os.path.join(os.getcwd(), filename)
    if os.path.isfile(path):
        with open(path) as f:
            interpreter.custom_instructions = f.read()
        break

# open-interpreter exposes no timeout on its LLM, and its own ollama
# reachability probe only fires for models named "ollama/…", not the
# "ollama_chat/…" used above — so an unreachable api_base blocks in litellm
# with nothing to interrupt it. Check the host here instead, where a timeout
# can be set. Only the netloc is used, so a wrong path cannot mask a live host.
def check_endpoint(url, timeout):
    probe = urllib.parse.urlsplit(url)._replace(path="", query="", fragment="")
    try:
        urllib.request.urlopen(urllib.parse.urlunsplit(probe), timeout=timeout)
    except urllib.error.HTTPError:
        # A 4xx/5xx still proves something is listening.
        return
    except OSError as exc:
        print(
            f"error: model endpoint {probe.netloc} unreachable ({exc}); "
            f"set AI_COMMIT_MSG_API_BASE to override",
            file=sys.stderr,
        )
        sys.exit(1)


diff = subprocess.run(
    ["git", "diff", "--staged"], capture_output=True, text=True
)
if diff.returncode != 0:
    # Most often "not a git repository". git has already written its own
    # message to stderr, so pass the status through rather than raising a
    # traceback over the top of it.
    sys.exit(diff.returncode)
if not diff.stdout.strip():
    print("error: no staged changes (git diff --staged is empty)", file=sys.stderr)
    sys.exit(1)
diff = diff.stdout

check_endpoint(interpreter.llm.api_base, float(os.environ.get("AI_COMMIT_MSG_TIMEOUT", "5")))

prompt = f"""Read the diff below. Output ONLY a commit message in this exact
format, nothing else, no markdown code fences. Use conventional commit format:

<type>(<scope>): <subject>

<body>

Diff:
{diff}"""

try:
    messages = interpreter.chat(prompt, display=False)
finally:
    # Shuts down the Jupyter kernel interpreter starts for code execution;
    # otherwise it notices this process exiting and logs an IPKernelApp
    # warning. finally also runs on Ctrl-C (KeyboardInterrupt), which is
    # when this most often triggers since chat() blocks on the model.
    interpreter.computer.terminate()

text = next(
    (
        m["content"]
        for m in reversed(messages)
        if m.get("role") == "assistant" and m.get("type") == "message"
    ),
    None,
)
if text is None:
    print("error: no assistant text message in response", file=sys.stderr)
    sys.exit(1)

# Small local models sometimes wrap output in code fences despite the
# instruction above; strip any such lines before handing off the message.
clean = "\n".join(line for line in text.splitlines() if not line.startswith("```"))
print(clean.strip())
