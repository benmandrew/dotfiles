#!/bin/sh
# Print one field of the Claude Code session running inside a tmux pane, or a
# fallback when the pane holds no session.
#
# Claude Code registers every live session in ~/.claude/sessions/<pid>.json,
# recording the agent identifier it is known by (`gwt` lists agents under these
# names) and the cwd it is actually working in. tmux sees only the shell, so it
# knows neither: #{pane_current_path} goes stale once claude chdir()s into a
# worktree while zsh sits suspended behind it, and #{window_name} follows the
# foreground command, which is "claude" for every agent alike. Look for a
# registered session inside the pane's process subtree and read the field off
# it; otherwise pass through whatever tmux already knew.
#
# Usage: claude-pane-session cwd|name <pane-pid> <fallback>
#        claude-pane-session status|status-current <pane-pid>
#        claude-pane-session refresh
set -u

sessions="${HOME}/.claude/sessions"
# What each session is working on, set by `claude-tab-title` and keyed by the
# same pid, which replaces the agent identifier in the window name.
titles="${HOME}/.claude/tab-titles"
# Sessions asking to be looked at, written by wezterm-notify.sh and removed once
# the tab is focused. The file's existence is the whole signal; its name is the
# same pid again.
bells="${HOME}/.claude/tab-bells"
# Per-user by construction on both platforms: XDG_RUNTIME_DIR is /run/user/<uid>
# on Linux, and TMPDIR is a private per-user directory on macOS.
cache="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/claude-pane-session.tsv"

field=${1:-}
pane_pid=${2:-}
fallback=${3:-}

emit_fallback() {
    printf '%s\n' "$fallback"
    exit 0
}

# One process-table snapshot plus one jq pass over every session file, written
# atomically so a concurrent reader never sees a half-built file. All four kinds
# of line are tab-separated: "P <pid> <ppid>" for the parent map, "S <pid> <name>
# <cwd> <status> <status-changed-at>" for the sessions, "T <pid> <title>" for the
# title overrides and "B <pid>" for the sessions asking to be looked at.
build_cache() {
    tmp="$cache.$$"
    {
        ps -axo pid=,ppid= 2>/dev/null | awk '{ print "P\t" $1 "\t" $2 }'
        # Newest first: claude rewrites the file on every status change, so a
        # pane holding more than one session resolves to the most recently
        # active one. Filenames are "<pid>.json", so no globbing hazard here.
        set --
        # shellcheck disable=SC2012
        for pid in $(ls -t "$sessions" 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)\.json$/\1/p'); do
            set -- "$@" "$sessions/$pid.json"
        done
        [ $# -eq 0 ] || jq -r '["S", (.pid | tostring), (.name // ""), (.cwd // ""),
                                (.status // ""), (.statusUpdatedAt // 0 | tostring)] | @tsv' "$@" 2>/dev/null
        # One awk over every override rather than a read apiece, since this runs
        # on every status tick. The pid is the filename, so FILENAME carries it.
        set --
        for f in "$titles"/*; do
            [ -f "$f" ] || continue
            set -- "$@" "$f"
        done
        [ $# -eq 0 ] || awk 'FNR == 1 && $0 != "" {
            n = split(FILENAME, path, "/")
            print "T\t" path[n] "\t" $0
        }' "$@" 2>/dev/null
        # A bell carries nothing but its own existence, so the filename is the
        # whole record and there is no file to read.
        for f in "$bells"/*; do
            [ -f "$f" ] || continue
            printf 'B\t%s\n' "${f##*/}"
        done
    } >"$tmp" 2>/dev/null || {
        rm -f "$tmp"
        return 1
    }
    mv -f "$tmp" "$cache" 2>/dev/null || {
        rm -f "$tmp"
        return 1
    }
}

# The tab bar WezTerm draws, in tmux: " <index> <bar><title> ", where the bar is
# U+258E LEFT ONE QUARTER BLOCK down the left edge of the chip, coloured by what
# the session is doing. Written by codepoint so an editor cannot mangle it.
BAR=$(printf '\342\226\216')
# Amber for working, blue for wanting you. Both are chosen to read against a
# window that is not the current one, which is the only place they are ever
# drawn: the current window's state is on screen in the pane below it, so its bar
# stays dim. Its dim is the midpoint of the current chip's orange and the bar's
# black; the other is the tab bar's own hover grey.
STATUS_BUSY='#e0a33e'
STATUS_ATTENTION='#6f9ede'
STATUS_DIM_CURRENT='#6d371b'
STATUS_DIM='#464444'
# How long a session sits idle before its bar turns to wanting you. Below this
# the pause is the gap between two of your own keystrokes.
WAIT_SECONDS=60
# Only the bar is answered against the clock, so only the bar pays for reading
# it; `name` is asked once per window per tick and should not fork for nothing.
now=0

# Walk each session's parent chain looking for the pane's own process. The hop
# cap is a guard against a cycle in a torn snapshot, not a real depth limit.
lookup() {
    awk -F '\t' -v root="$pane_pid" -v want="$field" \
        -v now="$now" -v bar="$BAR" -v busy="$STATUS_BUSY" \
        -v attention="$STATUS_ATTENTION" -v dim_current="$STATUS_DIM_CURRENT" \
        -v dim="$STATUS_DIM" -v wait_seconds="$WAIT_SECONDS" '
        # What the window is called: the task the session set with
        # claude-tab-title, else the agent identifier claude derived. The
        # identifier keeps its two-character suffix on the front of the task
        # ("atuin:d8"), so several agents in one project still read apart. An
        # identifier without one was renamed by hand, and a name someone chose
        # is worth less than the task, so the task stands alone.
        function window_name(i,   name, task) {
            name = sname[i]
            if (!(spid[i] in title)) return name
            task = title[spid[i]]
            if (match(name, /-[0-9A-Za-z][0-9A-Za-z]$/)) return task ":" substr(name, RSTART + 1)
            return task
        }
        # The bar down the chip, as a tmux style plus the glyph. The current
        # window always gets the dim one, since the only reason to colour a bar
        # is a window you cannot see. statusUpdatedAt is epoch milliseconds and
        # claude rewrites it on every busy/idle transition, so the difference
        # from now is the age of the state the session is in.
        function window_status(i,   colour, weight, waited) {
            colour = dim
            weight = "nobold"
            if (want == "status-current") {
                colour = dim_current
            } else if (spid[i] in bell) {
                colour = attention
                weight = "bold"
            } else if (sstatus[i] == "busy") {
                colour = busy
            } else {
                waited = supdated[i] > 0 ? now - int(supdated[i] / 1000) : 0
                if (waited >= wait_seconds) colour = attention
            }
            return "#[fg=" colour "," weight "]" bar
        }
        $1 == "P" { parent[$2 + 0] = $3 + 0 }
        $1 == "S" {
            n++; spid[n] = $2 + 0; sname[n] = $3; scwd[n] = $4
            sstatus[n] = $5; supdated[n] = $6 + 0
        }
        $1 == "T" { title[$2 + 0] = $3 }
        $1 == "B" { bell[$2 + 0] = 1 }
        END {
            target = root + 0
            for (i = 1; i <= n; i++) {
                p = spid[i]
                for (hops = 0; p > 1 && hops < 64; hops++) {
                    if (p == target) {
                        if (want == "cwd") print scwd[i]
                        else if (want == "name") print window_name(i)
                        else print window_status(i)
                        exit
                    }
                    if (!(p in parent)) break
                    p = parent[p]
                }
            }
        }
    ' "$cache" 2>/dev/null
}

# The status line refreshes the cache once per tick (see status-left in
# dot_tmux.conf), which is what keeps the per-window `name` lookups cheap: one
# ps and one jq for the whole tick instead of one of each per window.
if [ "$field" = refresh ]; then
    if [ -d "$sessions" ] && command -v jq >/dev/null 2>&1; then
        build_cache || true
    fi
    exit 0
fi

case $field in
    # A window with no claude session in it gets no bar at all, matching the
    # WezTerm tab, so the empty fallback is the answer rather than a miss.
    status | status-current)
        fallback=''
        now=$(date +%s)
        ;;
    cwd | name) ;;
    *) emit_fallback ;;
esac
case $pane_pid in
    '' | *[!0-9]*) emit_fallback ;;
esac
[ -d "$sessions" ] || emit_fallback
command -v jq >/dev/null 2>&1 || emit_fallback

if [ "$field" = cwd ]; then
    # Asked for once, on the keypress that opens a split or window, where a
    # stale answer sends the new pane somewhere wrong. Always work from a fresh
    # snapshot; nothing is polling this, so the cost lands on one keypress.
    build_cache || emit_fallback
elif [ -z "$(find "$cache" -mmin -1 2>/dev/null)" ]; then
    # Polled per window per tick, so this reads what the status line built. The
    # rebuild here is a safety net for a tmux without that status-left entry --
    # in steady state the cache is seconds old and no window ever pays for it.
    build_cache || emit_fallback
fi

value=$(lookup)
[ -n "$value" ] || emit_fallback
# A cwd is about to be handed to `tmux -c`, which fails outright on a stale one.
[ "$field" != cwd ] || [ -d "$value" ] || emit_fallback

printf '%s\n' "$value"
