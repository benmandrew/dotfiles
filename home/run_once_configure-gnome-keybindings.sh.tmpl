#!/bin/bash

set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

# Split monitor vs workspace movement for a vertically stacked two-monitor
# setup: Up/Down moves the window between monitors, Left/Right between
# workspaces. Both previously shared <Control><Shift><Alt>{Up,Down}, so only
# one action could ever fire for a given keypress.
gsettings set org.gnome.desktop.wm.keybindings move-to-workspace-up "[]"
gsettings set org.gnome.desktop.wm.keybindings move-to-workspace-down "[]"
gsettings set org.gnome.desktop.wm.keybindings move-to-monitor-up "['<Control><Shift><Alt>Up']"
gsettings set org.gnome.desktop.wm.keybindings move-to-monitor-down "['<Control><Shift><Alt>Down']"
{{ end -}}
