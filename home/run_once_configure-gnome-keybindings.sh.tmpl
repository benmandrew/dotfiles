#!/bin/bash

set -euo pipefail
{{- if eq .chezmoi.os "linux" }}

# Same headless guards as the input-sources script, which explains them:
# gsettings ships with glib, and without a session bus every write fails to
# commit.
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
    [ -z "${DISPLAY:-}" ] &&
    [ -z "${WAYLAND_DISPLAY:-}" ]; then
    bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
    if [ -S "${bus}" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
    elif command -v gnome-shell >/dev/null 2>&1; then
        echo "${0##*/}: GNOME is installed but no session bus is reachable;" >&2
        echo "  log in to the desktop, then run chezmoi apply again." >&2
        exit 1
    else
        exit 0
    fi
fi

# Set a key only where its schema is installed and has it, as in the
# preferences script: a server with glib but no GNOME schemas would otherwise
# fail `gsettings set` and, under set -e, the whole apply.
gset() {
    if gsettings range "$1" "$2" >/dev/null 2>&1; then
        gsettings set "$1" "$2" "$3"
    fi
}

# One modifier per layer: Super moves around the desktop, the WezTerm leader
# around the terminal, Ctrl around an app's tabs. Each action has one binding;
# GNOME's defaults gave a workspace move three.

# Super+N goes to workspace N and Super+Shift+N takes the window there, as
# Leader N goes to WezTerm tab N. Numbered jumps need a fixed set of
# workspaces; with dynamic ones, Super+N past the last does nothing. GNOME's
# switch-to-application and dash-to-dock's app hotkeys both claim Super+N.
gset org.gnome.mutter dynamic-workspaces false
gset org.gnome.desktop.wm.preferences num-workspaces 9
gset org.gnome.shell.extensions.dash-to-dock hot-keys false
for n in 1 2 3 4 5 6 7 8 9; do
    gset org.gnome.shell.keybindings "switch-to-application-${n}" "[]"
    gset org.gnome.desktop.wm.keybindings "switch-to-workspace-${n}" "['<Super>${n}']"
    gset org.gnome.desktop.wm.keybindings "move-to-workspace-${n}" "['<Super><Shift>${n}']"
done

# Neighbouring workspaces on Super+PgUp/PgDn only. Ctrl+Alt+arrows go back to
# apps, which use them for multiple cursors. Workspaces run left to right, so
# up and down have nothing to do.
gset org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Super>Page_Up']"
gset org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Super>Page_Down']"
gset org.gnome.desktop.wm.keybindings move-to-workspace-left "['<Super><Shift>Page_Up']"
gset org.gnome.desktop.wm.keybindings move-to-workspace-right "['<Super><Shift>Page_Down']"
gset org.gnome.desktop.wm.keybindings switch-to-workspace-up "[]"
gset org.gnome.desktop.wm.keybindings switch-to-workspace-down "[]"
gset org.gnome.desktop.wm.keybindings move-to-workspace-up "[]"
gset org.gnome.desktop.wm.keybindings move-to-workspace-down "[]"

# Forge's Super+Shift+h/j/k/l carries a tiled window over the monitor edge.
# These are for floating windows, which Forge leaves alone. The monitors are
# stacked vertically, so left and right have nothing to do.
gset org.gnome.desktop.wm.keybindings move-to-monitor-up "['<Super><Shift>Up']"
gset org.gnome.desktop.wm.keybindings move-to-monitor-down "['<Super><Shift>Down']"
gset org.gnome.desktop.wm.keybindings move-to-monitor-left "[]"
gset org.gnome.desktop.wm.keybindings move-to-monitor-right "[]"

# Free Super+H and Super+L for Forge, which focuses left and right on
# Super+h/j/k/l. GNOME takes a key first, so on its defaults Super+H minimised
# the window and Super+L locked the screen.
gset org.gnome.desktop.wm.keybindings minimize "['<Super>comma']"
gset org.gnome.settings-daemon.plugins.media-keys screensaver "['<Control><Alt>l']"
{{- end }}
