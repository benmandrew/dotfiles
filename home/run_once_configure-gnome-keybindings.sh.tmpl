#!/bin/bash

set -euo pipefail
{{- if eq .chezmoi.os "linux" }}

# Same headless guards as the input-sources script, which explains them:
# gsettings ships with glib, and without a session bus every write fails to
# commit.
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
    [ -z "${DISPLAY:-}" ] &&
    [ -z "${WAYLAND_DISPLAY:-}" ]; then
    bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
    if [ -S "${bus}" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
    elif command -v gnome-shell >/dev/null 2>&1; then
        echo "${0##*/}: GNOME is installed but no session bus is reachable;" >&2
        echo "  log in to the desktop, then run chezmoi apply again." >&2
        exit 1
    else
        exit 0
    fi
fi

# Set a key only where its schema is installed and has it, as in the
# preferences script: a server with glib but no GNOME schemas would otherwise
# fail `gsettings set` and, under set -e, the whole apply. Forge's schema ships
# inside the extension, not in the system schema directory, so it needs
# --schemadir.
forge_schemas="${HOME}/.local/share/gnome-shell/extensions/forge@jmmaranan.com/schemas"
kset() {
    local dir=""
    case "$1" in
        wm) set -- org.gnome.desktop.wm.keybindings "$2" "$3" ;;
        shell) set -- org.gnome.shell.keybindings "$2" "$3" ;;
        media) set -- org.gnome.settings-daemon.plugins.media-keys "$2" "$3" ;;
        forge)
            set -- org.gnome.shell.extensions.forge.keybindings "$2" "$3"
            dir="${forge_schemas}"
            ;;
        *)
            echo "${0##*/}: unknown schema alias $1" >&2
            return 1
            ;;
    esac
    if [ -n "${dir}" ]; then
        if [ -d "${dir}" ] && gsettings --schemadir "${dir}" range "$1" "$2" >/dev/null 2>&1; then
            gsettings --schemadir "${dir}" set "$@"
        fi
    elif gsettings range "$1" "$2" >/dev/null 2>&1; then
        gsettings set "$@"
    fi
}

# Super+N jumps to workspace N, which needs a fixed set of workspaces: with
# dynamic ones, Super+N past the last does nothing. dash-to-dock's app
# hotkeys also claim Super+N.
if gsettings range org.gnome.mutter dynamic-workspaces >/dev/null 2>&1; then
    gsettings set org.gnome.mutter dynamic-workspaces false
    gsettings set org.gnome.desktop.wm.preferences num-workspaces 9
fi
if gsettings range org.gnome.shell.extensions.dash-to-dock hot-keys >/dev/null 2>&1; then
    gsettings set org.gnome.shell.extensions.dash-to-dock hot-keys false
fi

# The bindings themselves are desktop_keys in .chezmoidata.yaml, which also
# feeds the WezTerm cheatsheet. Mutter rereads a changed accelerator, so they
# apply in the running shell.
{{- range .desktop_keys.bindings }}
{{-   if hasSuffix "#" .key }}
for n in 1 2 3 4 5 6 7 8 9; do
    kset {{ .schema }} "{{ trimSuffix "#" .key }}${n}" "['{{ trimSuffix "#" .accel }}${n}']"
done
{{-   else }}
kset {{ .schema }} {{ .key }} "['{{ .accel }}']"
{{-   end }}
{{- end }}
{{- range $schema, $keys := .desktop_keys.cleared }}
{{-   range $keys }}
{{-     if hasSuffix "#" . }}
for n in 1 2 3 4 5 6 7 8 9; do
    kset {{ $schema }} "{{ trimSuffix "#" . }}${n}" "[]"
done
{{-     else }}
kset {{ $schema }} {{ . }} "[]"
{{-     end }}
{{-   end }}
{{- end }}
{{- end }}
