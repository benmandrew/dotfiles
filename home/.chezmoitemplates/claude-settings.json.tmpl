{{- /* The Bash tool runs $SHELL, and fish, the login shell, is not POSIX, so
       commands written as bash break. zsh breaks them too, since it does not
       word-split an unquoted $var. Prefer the nix profile's bash, since
       macOS ships 3.2 as /bin/bash. Claude Code ignores a path that does not
       run and falls back to $SHELL. */ -}}
{{- $nixBash := joinPath .chezmoi.homeDir ".nix-profile/bin/bash" -}}
{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_SHELL": {{ if stat $nixBash }}{{ $nixBash | quote }}{{ else }}"/bin/bash"{{ end }}
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*_rsa)",
      "Read(~/.ssh/id_*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/deny-stray-worktree.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/idle-notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status-refresh.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status-refresh.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/compact-status-write.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/compact-status-read.sh"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 300000,
  "outputStyle": "voice",
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); pct=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); [ -n \"$pct\" ] && printf 'ctx %.0f%%' \"$pct\" || echo 'ctx -'"
  },
  "extraKnownMarketplaces": {
    "isaaccorley-skills": {
      "source": {
        "source": "github",
        "repo": "isaaccorley/skills"
      }
    }
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "bib-audit@isaaccorley-skills": false
  },
  "skipDangerousModePermissionPrompt": true
}
