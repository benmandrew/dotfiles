export VIRTUAL_ENV_DISABLE_PROMPT=1

# zsh-nvm — lazy-loads nvm on first use without zinit overhead
export NVM_LAZY_LOAD=true
_zsh_nvm_plugin="${HOME}/.local/share/zsh-nvm/zsh-nvm.plugin.zsh"
if [[ ! -f "$_zsh_nvm_plugin" ]]; then
  # Fallback: zinit install location for existing setups
  _zsh_nvm_plugin="${HOME}/.local/share/zinit/zinit.git/plugins/lukechilds---zsh-nvm/zsh-nvm.plugin.zsh"
fi
[[ -f "$_zsh_nvm_plugin" ]] && source "$_zsh_nvm_plugin"
unset _zsh_nvm_plugin

# Both prepends run before compinit, which reads fpath once and never looks at
# it again.
#
# rustup keeps _cargo and _rustup inside the active toolchain rather than
# installing them anywhere on fpath. (N) drops the entry on a machine without
# rust instead of leaving compinit a directory that does not exist. The glob
# can match more than one toolchain — a cross-compilation target installs its
# own — and they carry the same functions, so first match wins and the rest
# cost compinit one directory scan a day.
# shellcheck disable=SC1036  # zsh glob qualifier, read as bash by the linter
fpath=($HOME/.rustup/toolchains/stable-*/share/zsh/site-functions(N) $fpath)
# Completion functions no package manager puts on fpath: the ones
# scripts/install-common.sh generates out of the tool itself (uv, fd, delta and
# the rest of install_zsh_completions) plus anything hand-written. On Linux this
# is the only source of them, since those tools arrive as bare binaries in
# ~/.local/bin with no site-functions directory alongside. Prepended last, so it
# sits at fpath[1] and a generated function beats a system one claiming the same
# command name — which is what points `delta` away from zsh's _sccs.
fpath=("${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions" $fpath)

autoload -Uz compinit
# Only rebuild the completion cache once a day (1440 min); -C on other
# startups skips compinit's expensive rescan of $fpath entirely. (N.mh-24) is
# zsh's own mtime test — the `find` this replaced forked a process on every
# single shell startup to answer the same question.
#
# The day the dump goes stale, the rebuild used to run in the foreground and
# the shell it landed in took 357 ms to reach a prompt. So the stale dump is
# sourced with -C as usual and the rescan happens in a backgrounded subshell,
# which writes a dump of its own and moves it over the old one — the shell that
# triggered the rebuild pays nothing for it, and the next shell picks the new
# dump up. Moved rather than written in place, so a shell starting mid-rebuild
# never reads a half-written dump. The dump goes first and the .zwc after it:
# zsh ignores a .zwc older than its dump, so the window between the two moves
# costs a slower source rather than a wrong one.
# shellcheck disable=SC1036  # zsh glob qualifier, read as bash by the linter
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
# shellcheck disable=SC1036  # zsh glob qualifier, read as bash by the linter
_zcompdump_fresh=("$_zcompdump"(N.mh-24))
if [[ ! -f "$_zcompdump" ]]; then
  # No dump at all — nothing to source, so this one has to be built here.
  compinit -d "$_zcompdump"
  (zcompile "$_zcompdump" &)
else
  compinit -C -d "$_zcompdump"
  if (( ! $#_zcompdump_fresh )); then
    # Backgrounded inside a subshell, the same idiom as the zcompile above:
    # the subshell exits at once and the job goes with it, so an interactive
    # shell never prints a job notification for it. $$ names the temp files
    # after this shell, so two shells rebuilding at once do not collide.
    ( {
        compinit -d "$_zcompdump.$$" \
          && zcompile "$_zcompdump.$$" \
          && mv -f "$_zcompdump.$$" "$_zcompdump" \
          && mv -f "$_zcompdump.$$.zwc" "$_zcompdump.zwc"
        rm -f "$_zcompdump.$$" "$_zcompdump.$$.zwc"
      } & )
  fi
fi
unset _zcompdump _zcompdump_fresh
# Case-insensitive, then partial-word (_/-), then substring matching.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
# fzf-tab draws the menu itself, and needs zsh's own one off to capture the
# unambiguous prefix. Without `menu no` both fire and the list flickers.
zstyle ':completion:*' menu no
# Split matches into their tag groups (files vs. directories vs. aliases)
# instead of one flat list, and label each group. fzf-tab reads the label to
# build its group headers, so the `format` line is what turns groups on there
# — plain text only, it discards escape sequences.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:warnings' format 'no matches: %d'
# Nothing on either platform sets LS_COLORS: macOS ships BSD ls, which reads
# LSCOLORS instead, and the Linux boxes get their tools as bare binaries with
# no login script to run `dircolors`. So the list-colors zstyle below expanded
# an empty variable and the completion menu came out uncoloured, and eza fell
# back to its own defaults. Written out rather than generated, because
# `dircolors -b` costs a fork (3.6 ms ± 0.9) on every startup for a constant,
# and because this block runs before the PATH assignments further down, so a
# `command -v` for it here would miss on a shell that has not sourced
# ~/.zprofile. eza reads the same variable, so `ls` and the completion menu
# agree on what a directory or an archive looks like.
export LS_COLORS="rs=0:di=01;34:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35"\
":bd=40;33;01:cd=40;33;01:or=40;31;01:mi=00:su=37;41:sg=30;43:ca=00"\
":tw=30;42:ow=34;42:st=37;44:ex=01;32"\
":*.tar=01;31:*.tgz=01;31:*.zip=01;31:*.gz=01;31:*.bz2=01;31:*.xz=01;31"\
":*.zst=01;31:*.7z=01;31:*.rar=01;31:*.deb=01;31:*.rpm=01;31"\
":*.jpg=01;35:*.jpeg=01;35:*.png=01;35:*.gif=01;35:*.bmp=01;35:*.tif=01;35"\
":*.svg=01;35:*.webp=01;35:*.pdf=01;35"\
":*.mp4=01;35:*.mkv=01;35:*.webm=01;35:*.mov=01;35:*.avi=01;35"\
":*.mp3=00;36:*.flac=00;36:*.wav=00;36:*.ogg=00;36:*.opus=00;36"

# Reuse the ls palette so completed paths carry the same colours as `ls`.
# shellcheck disable=SC2296  # zsh flag syntax, read as bash by the linter
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Cache completions that shell out (apt, brew, ...).
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${ZDOTDIR:-$HOME}/.zcompcache"
# make: complete only Makefile targets, not directory files
zstyle ':completion:*:*:make:*' tag-order 'targets'
# Describe each option beside its flag instead of listing bare flag names.
# fzf-tab's picker is 60% of the terminal height and has the room for it.
zstyle ':completion:*' verbose yes
zstyle ':completion:*:options' description 'yes'
# Offer . and .. as matches, so `cd ../<TAB>` walks upwards.
zstyle ':completion:*' special-dirs true
# Notice a binary installed since the shell started, without a manual `rehash`.
zstyle ':completion:*' rehash true

# zsh's bundled _sccs claims the command name `delta` — SCCS has a subcommand
# called that — so git-delta completed SCCS flags. install_zsh_completions
# generates a real _delta from `delta --generate-completion zsh`; point the
# name at it whenever that file made it onto fpath.
# shellcheck disable=SC1036,SC1072,SC1073  # zsh glob qualifier and rc-expansion
if [[ -n ${^fpath}/_delta(N[1]) ]]; then
  compdef _delta delta
fi

setopt COMPLETE_IN_WORD    # complete from the cursor, not just word end
setopt ALWAYS_TO_END       # move cursor to word end after completing

# SSH agent. macOS runs one under launchd and hands every session an
# SSH_AUTH_SOCK, so this block never fires there; it is for the Linux machines
# and for a login reached without agent forwarding.
#
# The agent is bound to a fixed socket rather than the random /tmp path
# ssh-agent picks for itself. Every terminal that inherited no SSH_AUTH_SOCK
# used to start an agent of its own and nothing ever reaped them, so a live
# socket is reused here and only a stale one is replaced. Keys are not loaded
# either: doing that meant a recursive `grep -slR ~/.ssh` per terminal, and
# `AddKeysToAgent yes` in ~/.ssh/config already adds each key on first use.
if [[ -o interactive && -z "$SSH_AUTH_SOCK" ]] && command -v ssh-agent > /dev/null 2>&1; then
  _ssh_agent_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
  _ssh_agent_sock="$_ssh_agent_dir/ssh-agent.sock"
  _ssh_agent_live=""
  if [[ -S "$_ssh_agent_sock" ]]; then
    # ssh-add exits 2 when it cannot open a connection; 1 is a live agent
    # holding no keys, which is still an agent worth keeping.
    SSH_AUTH_SOCK="$_ssh_agent_sock" ssh-add -l > /dev/null 2>&1
    # shellcheck disable=SC2181  # the exit status is the whole test
    (( $? != 2 )) && _ssh_agent_live=1
  fi
  if [[ -z "$_ssh_agent_live" ]]; then
    mkdir -p "$_ssh_agent_dir"
    rm -f "$_ssh_agent_sock"
    ssh-agent -a "$_ssh_agent_sock" > /dev/null 2>&1
  fi
  [[ -S "$_ssh_agent_sock" ]] && export SSH_AUTH_SOCK="$_ssh_agent_sock"
  unset _ssh_agent_dir _ssh_agent_sock _ssh_agent_live
fi

# zsh keeps `path` and `PATH` tied to one another, and -U makes `path` a unique
# array: an entry already present is not added twice, and the first occurrence
# is the one kept. Without it the blocks below appended a second copy of
# themselves in every nested interactive shell — a tmux pane inside a shell
# inside `exec zsh` — and PATH grew without bound. It had reached 77 entries,
# with every line of the macOS block present twice.
typeset -U path PATH
{{ if eq .chezmoi.os "darwin" }}

export HOMEBREW_BASE="/opt/homebrew/opt"
export CC=clang
export CXX=clang++

# Ahead of the system directories. These hold the binaries the install scripts
# manage, and a same-named copy under /usr/bin or /usr/local/bin must not win.
# Appending put them behind both, so a stale system binary shadowed the managed
# one in silence: a /usr/local/bin/starship left by an older run kept being
# used while ~/.local/bin/starship sat there unread. Highest priority first.
# ~/.cargo/bin is listed here as well as in ~/.zshenv, which is where
# `. ~/.cargo/env` puts it. That runs before this block, so without the entry
# the rustup shims landed behind /opt/homebrew/bin — the shadowing this list
# exists to prevent. typeset -U keeps the first occurrence, so naming it here
# wins and the duplicate is dropped.
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/Library/Python/3.10/bin"
  "$HOME/.cargo/bin"
  "${GOPATH:-$HOME/go}/bin"
  $path
)

# Behind the system directories, for things that supplement it rather than
# replace it. llvm stays here on purpose, so `clang` is still Xcode's and CC
# above keeps meaning what it has always meant.
path+=(
  "$HOMEBREW_BASE/openjdk/bin"
  "$HOMEBREW_BASE/llvm/bin"
  "/Applications/Docker.app/Contents/Resources/bin"
)

export JAVA_DIR="$HOMEBREW_BASE/openjdk"
export JAVA_HOME="$HOMEBREW_BASE/openjdk/bin/java"

export LIBRARY_PATH="$LIBRARY_PATH:${HOMEBREW_BASE%/opt}/lib"

{{ else if eq .chezmoi.os "linux" }}

# Same split as the macOS branch above: user-managed binaries in front of the
# system ones, everything else behind. /usr/local/bin is dropped rather than
# re-added, since the system login PATH already carries it.
path=(
  "$HOME/.local/bin"
  "$HOME/usr/bin"
  "$HOME/.cargo/bin"
  "${GOPATH:-$HOME/go}/bin"
  $path
)

path+=(
  /usr/local/go/bin
  /opt/nvim-linux-x86_64/bin
)

{{ end }}

# OSC 7: report cwd to the terminal on every prompt. Needed for WezTerm to
# track the tab's directory over SSH (and through tmux, remote or local),
# since it can't introspect a remote process's cwd directly like it can for
# local panes.
autoload -Uz add-zsh-hook
#
# Two things about the encoding loop. `printf -v` writes into the variable
# directly, where the $(printf ...) it replaced forked a subshell for every
# character that needed escaping. And nomultibyte makes the string index by
# byte rather than by character, which is what RFC 3986 asks for: indexing by
# character handed printf a code point, so a path holding é reported %E9
# instead of its two UTF-8 bytes %C3%A9 and the terminal read the directory as
# a different one. localoptions keeps that option inside the function.
_osc7_cwd() {
  setopt localoptions nomultibyte
  local i c hex encoded=""
  for (( i = 1; i <= ${#PWD}; ++i )); do
    c="${PWD:$((i-1)):1}"
    case "$c" in
      [A-Za-z0-9_.!~*\'\(\)/:-]) encoded+="$c" ;;
      *) printf -v hex '%%%02X' "'$c"; encoded+="$hex" ;;
    esac
  done
  printf '\e]7;file://%s%s\e\\' "${HOST}" "$encoded"
}
add-zsh-hook precmd _osc7_cwd

export LANG="en_GB.UTF-8"
export LC_ALL="en_GB.UTF-8"

export COLORTERM=truecolor

alias vim="nvim"
# Not "vim" — the alias is interactive-only, so tools that exec $EDITOR
# (ansible-vault, git, crontab) would get real vim and its ~/.vimrc.
export VISUAL=nvim
export EDITOR="$VISUAL"

# Read by the zstd CLI itself, so everything that shells out to it inherits
# them — tar --zstd, mksquashfs, borg. 0 threads means one per core; level 6
# still compresses faster than `gzip -6` at a noticeably better ratio.
export ZSTD_NBTHREADS=0
export ZSTD_CLEVEL=6

# -a picks the compressor from the output suffix (`tarc x.tar.zst ./dir`).
# Extraction needs no flag at all: tar sniffs the magic bytes, so a plain
# `tar -xf` handles .zst, .gz and .xz alike.
alias tarc="tar -a -cf"

# Guarded, because a box that has not run the install scripts yet has no moor,
# and an unconditional MANPAGER makes `man` fail rather than fall back to less.
if command -v moor > /dev/null 2>&1; then
  export PAGER="moor --wrap --tab-size=4 --quit-if-one-screen"
  export MANPAGER="$PAGER"
  alias less=moor
fi

# glow looks for glow.yml under ~/Library/Preferences on macOS and under
# $XDG_CONFIG_HOME on Linux, so the chezmoi-managed ~/.config/glow/glow.yml,
# which sets `pager: true`, applied on Linux alone. GLOW_CONFIG_HOME names the
# directory holding glow.yml outright, and glow honours it on both platforms.
export GLOW_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/glow"

# `watch` runs its command through sh, which knows nothing of this shell's
# aliases, so `watch gwt` reports "gwt: command not found". Expand the command
# word here instead. An alias ending in a space would expand the word after it
# and nothing more, which breaks the moment a flag comes between the two, as in
# `watch -n1 gwt`; the command word is the first one that is neither a flag nor
# the argument of one.
#
# --color, with the force flag beside it, keeps the colour these listings drop
# as soon as they see a pipe rather than a terminal.
unalias watch 2>/dev/null || true
watch() {
  local -a args
  local arg seen="" value=""
  for arg in "$@"; do
    if [[ -z $seen && -z $value && $arg != -* ]]; then
      seen=1
      # (z) splits the alias body into words the way the parser would.
      # shellcheck disable=SC2296  # zsh flag syntax, read as bash by the linter
      args+=(${(z)${aliases[$arg]:-$arg}})
    else
      args+=("$arg")
      # -n takes the interval as a separate word, which would otherwise look
      # like the command; every other flag carries its argument attached.
      # Spelt out rather than as the glob (-n|--interval), which shellcheck
      # reads as bash and rejects.
      if [[ $arg == -n || $arg == --interval ]]; then value=1; else value=""; fi
    fi
  done
  GIT_WT_FORCE_COLOUR=1 command watch --color "${args[@]}"
}

# Function (not alias) so piping still works: eza's --long forces its table
# format even when stdout isn't a tty, which breaks idioms like `ls | xargs`.
# unalias first: zsh refuses to define a function over an existing alias
# of the same name (e.g. one set by a system skeleton .zshrc).
# Guarded for the same reason as moor above: without eza this left `ls` as a
# function calling a binary that is not there, so the first command on a fresh
# box failed. Unguarded, the system ls stays in place.
unalias ls 2>/dev/null || true
if command -v eza > /dev/null 2>&1; then
  ls() {
    if [[ -t 1 ]]; then
      eza --long --group-directories-first "$@"
    else
      eza --oneline --group-directories-first "$@"
    fi
  }
  alias lsa="eza --long --group-directories-first --all"
fi
# Spelt through `ls` rather than through eza, so both names still work when the
# guard above did not fire and `ls` is the system one.
alias ll="ls -l"
alias la="ls -la"

mkcd() { mkdir -p -- "$1" && cd -- "$1"; }

# AUTO_PUSHD makes each of these a dirstack entry, so `cd -` walks back up.
# `..` needs no alias: AUTO_CD reads a bare directory name as a cd already.
alias ...="cd ../.."
alias ....="cd ../../.."

# fd and rg are installed and barely reached for — 7 uses against 180 of
# `find`, 3 against 31 of `grep` in the recorded history. Short names rather
# than taking the old ones: neither tool is a drop-in, since rg makes recursion
# the default and spells -r as its replace flag while fd shares no syntax at
# all with find's predicate expressions, so shadowing `find` and `grep` would
# break every invocation that carries a flag instead of redirecting it. These
# are defined in .zshrc, so scripts and non-interactive shells see none of it.
if command -v fd > /dev/null 2>&1; then
  alias f="fd"
  # fd honours .gitignore and skips dotfiles; the search that finds nothing is
  # usually one of those two, so the second name turns both off.
  alias fa="fd --hidden --no-ignore"
fi
if command -v rg > /dev/null 2>&1; then
  alias rga="rg --hidden --no-ignore"
fi
alias python="python3"
alias cz="chezmoi"

# Shadow the C-compiler `cc` interactively only — Makefiles/build scripts that
# exec `cc` still hit the real /usr/bin/cc, since aliases aren't expanded there.
alias cc="claude"

alias gst="git st"
alias gs="git st"
alias gsv="git sv"
alias gbv="git bv"
alias grv="git rv"
alias gch="git ch"
alias ga="git add -A"
alias gd="git diff"
alias gdc="git diff --cached"
alias gll="git ll"
alias gdl="git dl"
alias gwt="git wt"
# The write verbs, on the same g<initials> pattern. gch above already covers
# checkout, so there is no separate gco.
alias gcm="git cm"
alias gp="git push"
alias gpl="git pull"
alias gb="git branch"
alias gf="git fetch --prune"
# Switching worktrees cannot be a git subcommand: `git wt` runs as a child
# process, so it can never change this shell's directory. Reuse its --paths
# output rather than listing worktrees again, so the picker and the plain
# listing can never drift apart. Field 1 is the absolute path, which the rows
# themselves no longer carry once they are shortened to a directory name.
gws() {
  local rows target
  rows=$(GIT_WT_FORCE_COLOUR=1 git wt --paths) || return
  target=$(print -r -- "$rows" | fzf --ansi --delimiter='\t' --with-nth=2.. \
    --height=40% --reverse --no-multi --prompt='worktree> ') || return
  [[ -n $target ]] && cd "${target%%$'\t'*}"
}
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000000
export SAVEHIST=1000000000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
# HISTFILE is the offline fallback for atuin, and atuin's secrets_filter does
# not reach it, so a command typed with a leading space to keep a token out of
# the history was still landing in ~/.zsh_history.
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_ALL_DUPS  # drop the older copy of a repeated command
setopt HIST_SAVE_NO_DUPS     # and never write a duplicate to the file
setopt HIST_FIND_NO_DUPS     # ^R walks distinct commands, not the same one
setopt HIST_REDUCE_BLANKS    # normalise whitespace before storing
setopt HIST_VERIFY           # a !-expansion lands on the line for review

# INTERACTIVE_COMMENTS was on only because `atuin init zsh` sets it, so a
# machine without atuin lost `#` comments at the prompt with nothing to say so.
setopt INTERACTIVE_COMMENTS

setopt AUTO_CD               # a bare directory name is a cd. It runs the
                             # builtin, so zoxide's `cd` never sees it and
                             # the jump is not recorded
setopt AUTO_PUSHD            # every cd pushes, so `cd -<TAB>` lists history
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT          # without it every cd prints the whole dirstack

setopt EXTENDED_GLOB         # ^, # and ~ in patterns; also the (N) qualifiers
setopt NO_CASE_GLOB          # match case-insensitively, as completion does
# GLOB_DOTS is deliberately left off. It would make * match dotfiles, so
# `rm *` in a project directory would take .git with it. Use *(D) or the
# explicit .* where a glob really should reach them.

unsetopt BEEP                # /etc/zshrc leaves it on, so every ambiguous
                             # completion beeps
unsetopt FLOW_CONTROL        # ^S froze the terminal; free it for the editor

bindkey -e
autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[OA" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search
bindkey "^[OB" down-line-or-beginning-search

# Option+Left/Right: WezTerm sends CSI 1;3D / 1;3C, which zsh's emacs
# keymap doesn't bind by default (only bare ESC-b/ESC-f are bound)
bindkey "^[[1;3D" backward-word
bindkey "^[[1;3C" forward-word

# Ctrl+Left/Right: WezTerm sends CSI 1;5D / 1;5C, unbound by default —
# falls through and leaks the trailing D/C as literal input otherwise
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word

# Home/End/Delete. /etc/zshrc binds these from terminfo, but it runs before the
# `bindkey -e` above, which installs the emacs keymap over the top — so whether
# they survive depends on a file this repo does not own. Bound here for both
# the CSI ~ and the CSI-letter forms, since which one arrives depends on the
# terminal's cursor-key mode.
bindkey "^[[H"  beginning-of-line
bindkey "^[[1~" beginning-of-line
bindkey "^[OH"  beginning-of-line
bindkey "^[[F"  end-of-line
bindkey "^[[4~" end-of-line
bindkey "^[OF"  end-of-line
bindkey "^[[3~" delete-char

# ^X^E opens the current line in $EDITOR and runs what comes back, for the
# command that has outgrown a single line.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey "^X^E" edit-command-line

# Claude
export MAX_THINKING_TOKENS=8000
export WORKSPACE_ROOTS="$HOME/projects"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# Cache init-script output keyed by the binary's path and mtime, so it
# regenerates when either changes. Path as well as mtime, because these
# generators bake the absolute path of the binary into what they emit —
# `starship init zsh` writes it into PROMPT. Putting ~/.local/bin ahead of the
# system directories, and deleting the /usr/local/bin/starship it had been
# shadowed by, left a cache holding the deleted path; the surviving binary was
# older than the cache, so the mtime test alone never fired and every prompt
# printed "no such file or directory". The stamp is a comment line, so a cache
# written before this existed fails the comparison and is rebuilt once.
#
# The arguments are in the stamp too. Keyed on the binary alone, editing
# `zoxide init zsh --cmd cd` or atuin's --disable flags changed nothing the
# check could see, so the cache written under the old flags was sourced
# indefinitely. Written out rather than hashed, since the stamp is a comment
# line either way and a hash would cost a fork to compute.
#
# `command -v` and `read` are builtins, so the check costs no fork. A command
# that has gone away takes its cache with it rather than being sourced stale.
_cache_eval() {
  local cmd="$1" cache="$HOME/.cache/zsh/${1}.zsh"
  local bin_path stamp first=''
  if ! bin_path="$(command -v "$cmd")"; then
    rm -f "$cache" "$cache.zwc"
    return
  fi
  stamp="# _cache_eval binary: $bin_path args: $*"
  [[ -f "$cache" ]] && read -r first < "$cache"
  if [[ "$first" != "$stamp" ]] || [[ "$bin_path" -nt "$cache" ]]; then
    mkdir -p "${cache:h}"
    { print -r -- "$stamp"; "$@" } >| "$cache"
    (zcompile "$cache" &)
  fi
  source "$cache"
}

_cache_eval zoxide init zsh --cmd cd
# Claude Code's per-command shells source a snapshot that omits chpwd_functions,
# so zoxide's doctor always sees its hook as "missing" and warns on every cd.
export _ZO_DOCTOR=0
export DIRENV_LOG_FORMAT=
_cache_eval direnv hook zsh

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# fzf-tab replaces the completion menu with an fzf picker, so every match list
# becomes fuzzy-searchable and can carry a preview pane. It reads the same
# zstyles as the built-in menu, so the matcher-list and tag-order rules above
# still apply. Sourced after ~/.fzf.zsh because it must be the last thing to
# bind ^I, and before anything that wraps ZLE widgets.
if [[ -f "$HOME/.local/share/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  source "$HOME/.local/share/fzf-tab/fzf-tab.plugin.zsh"

  # Group headers only become navigable with a key to cycle them.
  zstyle ':fzf-tab:*' switch-group '<' '>'
  # Accept the match and immediately complete the next word, so a path can be
  # walked one directory per <tab> without restarting the picker.
  zstyle ':fzf-tab:*' continuous-trigger '/'
  # -i forces case-insensitive matching. fzf is smart-case by default, and
  # fzf-tab seeds the query with the word already typed, so a typed capital
  # (`Dow`) made fzf drop the lowercase candidates zsh's matcher-list had just
  # generated (`dowager`, `downstream`) and the picker read as case-sensitive.
  zstyle ':fzf-tab:*' fzf-flags -i --height=60% --layout=reverse --border --info=inline

  # Recipe body of the make target under the cursor. A script on PATH, not a
  # function: previews run in a separate `zsh -c` that inherits no functions.
  zstyle ':fzf-tab:complete:make:*' fzf-preview 'make-target-recipe $word'

  zstyle ':fzf-tab:complete:cd:*' fzf-preview \
    'eza --oneline --colour=always --group-directories-first $realpath'
  zstyle ':fzf-tab:complete:*:*' fzf-preview \
    '[[ -d $realpath ]] && eza --oneline --colour=always --group-directories-first $realpath ||
     { [[ -f $realpath ]] && bat --color=always --style=numbers --line-range=:200 $realpath; }'
  # git checkout/switch: show the commits the ref points at.
  zstyle ':fzf-tab:complete:git-(checkout|switch|rebase|merge):*' fzf-preview \
    'git log --oneline --graph --color=always -20 $word 2>/dev/null'
fi

# fzf pickers over git objects on ^G^B (branches), ^G^F (files), ^G^H (hashes),
# ^G^T (tags) and ^G^R (remotes), cloned by install_fzf_git. Sourced after the
# fzf-tab block because it binds the ^G prefix through zle, which needs the
# line editor already set up. Guarded because it is a clone rather than a
# package, so a machine that has not run the install scripts has no such file.
_fzf_git="${XDG_DATA_HOME:-$HOME/.local/share}/fzf-git.sh/fzf-git.sh"
[[ -f "$_fzf_git" ]] && source "$_fzf_git"
unset _fzf_git

# atuin stores history in its own SQLite db and syncs it per command record, so
# two machines merge instead of conflicting the way a shared ~/.zsh_history
# would. HISTFILE above still gets written, and stays the offline fallback.
#
# Sourced after ~/.fzf.zsh, which binds ^R to fzf-history-widget: the later
# binding wins, and the atuin picker is the one wanted.
#
# Both --disable flags give a key back. --disable-up-arrow keeps the
# up-line-or-beginning-search bindings above, which atuin would otherwise
# replace with its own search on ^[[A. --disable-ai drops its binding of `?` at
# an empty prompt, which opens a TUI that sends the typed question to a hosted
# service — the opposite of why the history lives on a private server.
if command -v atuin >/dev/null 2>&1; then
{{- $atuinHost := index .atuin.hostnames .chezmoi.hostname | default "" }}
{{- if $atuinHost }}
  # The name this machine is recorded under, from atuin.hostnames in
  # .chezmoidata.yaml. It only applies to commands recorded from here on:
  # records already written keep the hostname, and `--filter-mode host` treats
  # the two as different machines.
  export ATUIN_HOST_NAME="{{ $atuinHost }}"
{{- end }}
  _cache_eval atuin init zsh --disable-up-arrow --disable-ai
fi

# zsh-autosuggestions greys the rest of the most recent matching command after
# the cursor, accepted with the right arrow. Cloned to ~/.local/share by
# install_zsh_autosuggestions.
#
# Sourced last of the line-editor plugins, because it wraps every ZLE widget
# that exists when it loads and has to see fzf-tab's and atuin's. Order matters
# for a second reason: `atuin init zsh` above sets ZSH_AUTOSUGGEST_STRATEGY to
# its own `atuin` strategy, which draws the suggestion from the synced database
# rather than this machine's $HISTFILE, and it only takes effect when atuin
# runs first. Nothing here sets the strategy, so that assignment stands.
_zsh_autosuggestions="${XDG_DATA_HOME:-$HOME/.local/share}/zsh-autosuggestions/zsh-autosuggestions.zsh"
if [[ -f "$_zsh_autosuggestions" ]]; then
  # Grey against the Hacktober background; the default 8 is invisible on it.
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c6c6c'
  # Do not suggest against a paste or a very long line — the widget rescans the
  # history on every keystroke and this is the case where that gets noticeable.
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=80
  source "$_zsh_autosuggestions"
fi
unset _zsh_autosuggestions

# Self-removing shim: only pay for sourcing opam-init on the first call,
# then unfunction so later invocations hit the real opam binary directly.
opam() {
  unfunction opam
  [[ -r "$HOME/.opam/opam-init/init.zsh" ]] && source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2>&1
  opam "$@"
}

# A dropped SSH link kills the session before the remote TUI can restore the
# terminal, so raw mode, mouse reporting, the hidden cursor and the alt charset
# stay set locally — which reads as a hung tab. Undo it on every ssh exit; a
# clean exit sees no difference. `stty sane` alone leaves the DEC private modes.
ssh() {
  command ssh "$@"
  local ret=$?
  if [[ -t 1 ]]; then
    stty sane
    printf '\e[?1049l\e[?25h\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?2004l\e(B\e[m\017'
  fi
  return $ret
}

