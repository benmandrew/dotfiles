{{- /* The OS glyph at the right of the prompt, rendered here as literal text.
     starship's own os module costs 54 ms of a 63 ms prompt on Linux, where it
     forks lsb_release on every prompt to learn what never changes between
     applies. Keyed on the os-release ID; any other distribution gets the
     generic penguin, as the module's Linux fallback did. */ -}}
{{- $osSymbol := " " -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $osSymbol = " " -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $symbols := dict -}}
{{-   $symbols = set $symbols "alpaquita" " " -}}
{{-   $symbols = set $symbols "alpine" " " -}}
{{-   $symbols = set $symbols "almalinux" " " -}}
{{-   $symbols = set $symbols "amzn" " " -}}
{{-   $symbols = set $symbols "aosc" " " -}}
{{-   $symbols = set $symbols "arch" " " -}}
{{-   $symbols = set $symbols "artix" " " -}}
{{-   $symbols = set $symbols "cachyos" " " -}}
{{-   $symbols = set $symbols "centos" " " -}}
{{-   $symbols = set $symbols "debian" " " -}}
{{-   $symbols = set $symbols "elementary" " " -}}
{{-   $symbols = set $symbols "endeavouros" " " -}}
{{-   $symbols = set $symbols "fedora" " " -}}
{{-   $symbols = set $symbols "garuda" "󰛓 " -}}
{{-   $symbols = set $symbols "gentoo" " " -}}
{{-   $symbols = set $symbols "kali" " " -}}
{{-   $symbols = set $symbols "mabox" " " -}}
{{-   $symbols = set $symbols "manjaro" " " -}}
{{-   $symbols = set $symbols "mariner" " " -}}
{{-   $symbols = set $symbols "linuxmint" " " -}}
{{-   $symbols = set $symbols "nixos" " " -}}
{{-   $symbols = set $symbols "nobara" " " -}}
{{-   $symbols = set $symbols "opensuse-leap" " " -}}
{{-   $symbols = set $symbols "opensuse-tumbleweed" " " -}}
{{-   $symbols = set $symbols "ol" "󰌷 " -}}
{{-   $symbols = set $symbols "pop" " " -}}
{{-   $symbols = set $symbols "raspbian" " " -}}
{{-   $symbols = set $symbols "rhel" " " -}}
{{-   $symbols = set $symbols "rocky" " " -}}
{{-   $symbols = set $symbols "solus" "󰠳 " -}}
{{-   $symbols = set $symbols "sles" " " -}}
{{-   $symbols = set $symbols "ubuntu" " " -}}
{{-   $symbols = set $symbols "void" " " -}}
{{-   $symbols = set $symbols "zorin" " " -}}
{{-   $osSymbol = get $symbols .chezmoi.osRelease.id | default $osSymbol -}}
{{- end -}}
# Get editor completions based on the config schema
"$schema" = 'https://starship.rs/config-schema.json'

# Inserts a blank line between shell prompts
add_newline = true

# starship's default. It was raised to 2000 for slow-starting version probes,
# which meant one hung probe held the prompt for two seconds. The probe it was
# raised for, `typst --version`, measures 8.2 ms +/- 0.5 warm and 0.43 s on a
# cold first run, so it clears 500 either way.
command_timeout = 500

format = "$all$fill [{{ $osSymbol }}](bold white)$time$line_break$character"

# Modules for languages and tools I don't use. Most run a version
# probe when its files turn up; on a cold run deno and fortran passed the
# 500 ms timeout, and swift took 1080 ms by trying two commands.
buf.disabled = true
bun.disabled = true
cobol.disabled = true
conda.disabled = true
crystal.disabled = true
dart.disabled = true
deno.disabled = true
dotnet.disabled = true
elixir.disabled = true
elm.disabled = true
erlang.disabled = true
fennel.disabled = true
fortran.disabled = true
gleam.disabled = true
gradle.disabled = true
guix_shell.disabled = true
haxe.disabled = true
helm.disabled = true
julia.disabled = true
kotlin.disabled = true
maven.disabled = true
meson.disabled = true
mojo.disabled = true
nim.disabled = true
opa.disabled = true
perl.disabled = true
php.disabled = true
pixi.disabled = true
pulumi.disabled = true
purescript.disabled = true
quarto.disabled = true
raku.disabled = true
red.disabled = true
rlang.disabled = true
scala.disabled = true
solidity.disabled = true
spack.disabled = true
swift.disabled = true
terraform.disabled = true
vagrant.disabled = true
vlang.disabled = true
xmake.disabled = true

[directory]
format = '[\[$path\]]($style)'
read_only = " 󰌾"

[character] # The name of the module we are configuring is 'character'
success_symbol = '[\$](bold green)' # The 'success_symbol' segment is being set to '➜' with the color 'bold green'
error_symbol = '[\$](bold red)'

[git_branch]
symbol = " "
style = "purple"
format = '[\[$branch(:$remote_branch)\]]($style)'

[git_status]
# gitoxide's untracked-file walk took 57 ms in a 19k-file repo, against 27 ms
# through the git binary.
use_git_executable = true
style = "red"
format = '([\[$all_status\]]($style))'
conflicted = ''
ahead = ''
behind = ''
diverged = ''

[time]
style ="yellow"
format = '[\[$time\]]($style)'
disabled = false

[fill]
symbol = ' '

[cmd_duration]
disabled = true

[battery]
disabled = true


# Disable the package module, hiding it from the prompt completely
[package]
disabled = true
symbol = "󰏗 "

[aws]
disabled = true
symbol = " "

[c]
format = ' [$symbol($version(-$name))]($style)'
disabled = true
symbol = " "

[cpp]
format = ' [$symbol($version(-$name))]($style)'
symbol = " "

[cmake]
format =" [$symbol($version)]($style)"
symbol = " "

[docker_context]
format = ' [$symbol$context]($style)'
symbol = " "

[fossil_branch]
symbol = " "

[gcloud]
symbol = " "

[git_commit]
tag_symbol = '  '

[golang]
format = ' [$symbol($version)]($style)'
symbol = " "

[haskell]
format = ' [$symbol($version)]($style)'
symbol = " "

[hg_branch]
symbol = " "

[hostname]
format ="@[$hostname]($style) "
ssh_symbol = " "

[java]
format = ' [${symbol}(${version})]($style)'
symbol = " "

[lua]
format = ' [$symbol($version)]($style)'
symbol = " "

[memory_usage]
format = ' $symbol [${ram}( \| ${swap})]($style)'
symbol = "󰍛 "

[nix_shell]
format = ' [$symbol$state]($style)'
symbol = " "

[nodejs]
format = ' [${symbol}(${version})]($style)'
symbol = " "

[ocaml]
# The switch name costs an `opam switch show` per prompt, 26 ms of the
# module's 42 ms.
format = ' [$symbol($version)]($style)'
symbol = " "

# Replaced by the literal glyph in format above.
[os]
disabled = true

[pijul_channel]
symbol = " "

[python]
format = ' [${symbol}(${version})( \($virtualenv\))]($style)'
python_binary = "python3"
symbol = " "

[ruby]
format =" [$symbol($version)]($style)"
detect_variables = []
symbol = " "

[rust]
format =" [$symbol($version)]($style)"
symbol = "󱘗 "

[status]
symbol = " "

[typst]
format = ' [$symbol($version)]($style)'

# starship has no LaTeX module. The command runs under sh, since the default
# STARSHIP_SHELL is zsh and would source ~/.zshenv on every prompt.
[custom.latex]
detect_extensions = ['tex', 'ltx', 'cls', 'sty']
detect_files = ['.latexmkrc', 'latexmkrc']
command = '''pdflatex --version | sed -n '1s/.*(TeX Live \([0-9]*\)).*/\1/p' '''
shell = ['sh']
# md-format_text, a serif T, escaped so editors cannot strip it. The font's
# three TeX glyphs are lettering, too thin to read in one cell.
symbol = "\U000F0284 "
style = 'bold green'
format = ' [$symbol($output)]($style)'

[username]
format = "[$user]($style)"

[zig]
format = ' [$symbol($version)]($style)'
symbol = " "
