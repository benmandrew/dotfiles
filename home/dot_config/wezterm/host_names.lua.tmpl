-- Short host names for remote tab titles, from home/.chezmoidata.yaml:
-- atuin.hostnames keyed by hostname, as OSC 7 reports it, and
-- wezterm.mux_domains keyed by ssh destination. Keys are lowercased, as
-- short_host in wezterm.lua leaves the names it compares.
return {
{{- range $host, $name := .atuin.hostnames }}
    [{{ $host | lower | quote }}] = {{ $name | quote }},
{{- end }}
{{- range .wezterm.mux_domains }}
    [{{ .host | lower | quote }}] = {{ .name | quote }},
{{- end }}
}
