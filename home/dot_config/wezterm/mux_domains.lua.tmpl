-- SSH multiplexing domains, from wezterm.mux_domains in home/.chezmoidata.yaml,
-- which the ssh function in dot_zshrc.tmpl reads too.
return {
{{- range .wezterm.mux_domains }}
    {
        name = {{ .name | quote }},
        remote_address = {{ .host | quote }},
{{- with .user }}
        username = {{ . | quote }},
{{- end }}
        multiplexing = "WezTerm",
    },
{{- end }}
}
