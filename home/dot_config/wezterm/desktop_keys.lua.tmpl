-- GNOME and Forge bindings for the cheatsheet, from desktop_keys in
-- home/.chezmoidata.yaml, which run_once_configure-gnome-keybindings.sh sets.
-- Each accel is a GTK accelerator; cheatsheet.lua turns it into a chord.
return {
{{- if eq .chezmoi.os "linux" }}
{{-   range .desktop_keys.bindings }}
    { group = {{ .group | quote }}, desc = {{ .desc | quote }}, accel = {{ .accel | replace "#" "1–9" | quote }} },
{{-   end }}
{{- end }}
}
