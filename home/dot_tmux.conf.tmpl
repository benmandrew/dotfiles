# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# RGB for truecolor; extkeys so tmux passes through distinct codes for
# modified keys (e.g. Ctrl/Option+arrow) instead of collapsing them
set-option -a terminal-features 'xterm-256color:RGB:extkeys'
set-option -g focus-events on
set -g extended-keys on

# forward OSC 7 (cwd) escape sequences to the outer terminal so WezTerm can
# track the pane's cwd through tmux — needed for SSH sessions where WezTerm
# can't introspect the remote foreground process directly
set -g allow-passthrough on

# on: tmux sends OSC 52 to the client terminal on yank (works over SSH)
set -s set-clipboard on

# reload config file
bind r source-file ~/.tmux.conf

# 0 avoids the default ~500ms delay tmux inserts after ESC, which reads as
# lag when exiting insert mode in vim/nvim
set -sg escape-time 0

# mirror WezTerm split/navigation bindings. New panes and windows inherit the
# pane's directory, but resolve it through claude-pane-session first: a pane
# running claude hands over the directory claude is actually working in, which
# diverges from #{pane_current_path} once claude moves workspace (into a
# worktree, say), because only the suspended shell's cwd is visible to tmux.
bind v run-shell -b 'tmux split-window -h -t "#{pane_id}" -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind s run-shell -b 'tmux split-window -v -t "#{pane_id}" -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind c run-shell -b 'tmux new-window -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind x kill-pane


# Enable mouse control (clickable windows, panes, resizable panes)
set -g mouse on
set -g default-terminal "tmux-256color"

# Status bar — Hacktober palette (mirrors WezTerm tab bar)
set -g status-style bg=#141414,fg=#c9c9c9
set -g window-status-style bg=#191918,fg=#c9c9c9
set -g window-status-current-style bg=#c75a22,fg=#141414,bold
# A window running claude is named after the agent ("counter-fe"), the same
# identifier `gwt` lists and the WezTerm tab shows, so a window can be matched to
# a row of that listing; #{window_name} is only "claude" for every agent alike.
# Anything else keeps the name tmux picked. tmux expands #() per window, with
# that window's own #{pane_pid}, and caches each job by command string.
set -g window-status-format ' #I  #(~/.local/bin/claude-pane-session name "#{pane_pid}" "#{window_name}") '
set -g window-status-current-format ' #I  #(~/.local/bin/claude-pane-session name "#{pane_pid}" "#{window_name}") '
set -g window-status-separator ""

# Pane borders: active uses Hacktober orange to match WezTerm focus highlight
set -g pane-active-border-style fg=#c75a22
set -g pane-border-style fg=#464444

set -g status-position top
# Single writer for the session cache the per-window name lookups read. tmux
# expands status-left once per tick, against N times for the window list, so
# putting the one ps snapshot and jq pass here keeps each window's lookup down to
# an awk over the cache. It prints nothing.
set -g status-left '#(~/.local/bin/claude-pane-session refresh)'
set -g status-right-length 120
set -g status-interval 5
set -g status-right "#[bg=#191918,fg=#c9c9c9] 󰒋 #{host_short}  󰍛 #(~/.config/tmux/cpu.sh)%%   #(~/.config/tmux/ram.sh)  󰥔 #(~/.config/tmux/uptime.sh) "

# Do nothing on bell
set -g visual-activity off
set -g visual-bell off
set -g visual-silence off
setw -g monitor-activity off
set -g bell-action none

# Mouse wheel and copy mode enhancements
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'select-pane -t=; copy-mode -e; send-keys -M'"
bind -n WheelDownPane select-pane -t= \; send-keys -M
bind -n C-WheelUpPane select-pane -t= \; copy-mode -e \; send-keys -M
bind -T copy-mode-vi    C-WheelUpPane   send-keys -X halfpage-up
bind -T copy-mode-vi    C-WheelDownPane send-keys -X halfpage-down
bind -T copy-mode-emacs C-WheelUpPane   send-keys -X halfpage-up
bind -T copy-mode-emacs C-WheelDownPane send-keys -X halfpage-down

# Use vim keybindings in copy mode
setw -g mode-keys vi

# Clipboard integration (OS-specific)
bind-key -T copy-mode-vi v send-keys -X begin-selection

{{ if eq .chezmoi.os "darwin" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'pbcopy'
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'pbcopy'
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'pbcopy'
{{ else if eq .chezmoi.os "linux" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
{{ end }}

# Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
run '~/.tmux/plugins/tpm/tpm'
