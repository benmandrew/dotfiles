# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# RGB for truecolor; extkeys so tmux passes through distinct codes for
# modified keys (e.g. Ctrl/Option+arrow) instead of collapsing them; hyperlinks
# so OSC 8 survives the pass through tmux. tmux's built-in xterm* feature set
# omits hyperlinks, so without this it strips the links delta, eza and gh emit,
# and the ctrl-click gesture in wezterm.lua has nothing to open.
set-option -a terminal-features 'xterm-256color:RGB:extkeys:hyperlinks'
set-option -g focus-events on
set -g extended-keys on

# forward OSC 7 (cwd) escape sequences to the outer terminal so WezTerm can
# track the pane's cwd through tmux — needed for SSH sessions where WezTerm
# can't introspect the remote foreground process directly
set -g allow-passthrough on

# on: tmux sends OSC 52 to the client terminal on yank (works over SSH)
set -s set-clipboard on

# Windows and panes count from 1, matching the number on the key you press to
# reach them. wezterm.lua renders tab_index + 1 for the same reason, so with the
# default base of 0 the two bars disagreed and prefix 1 landed on the second
# window. renumber-windows closes the gap a closed window leaves, so the numbers
# stay contiguous and #I keeps matching the key.
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# reload config file
bind r source-file ~/.tmux.conf

# 0 avoids the default ~500ms delay tmux inserts after ESC, which reads as
# lag when exiting insert mode in vim/nvim
set -sg escape-time 0

# mirror WezTerm split/navigation bindings. New panes and windows inherit the
# pane's directory, but resolve it through claude-pane-session first: a pane
# running claude hands over the directory claude is actually working in, which
# diverges from #{pane_current_path} once claude moves workspace (into a
# worktree, say), because only the suspended shell's cwd is visible to tmux.
bind v run-shell -b 'tmux split-window -h -t "#{pane_id}" -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind s run-shell -b 'tmux split-window -v -t "#{pane_id}" -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind c run-shell -b 'tmux new-window -c "$(~/.local/bin/claude-pane-session cwd "#{pane_pid}" "#{pane_current_path}")"'
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind x kill-pane

# The three defaults the bindings above displaced, given somewhere else to live.
# Shift is the free half of each key: s, l and x are taken by the WezTerm-mirror
# bindings, and their uppercase forms are unbound.
#
# last-window is the one that is missed most, so it also gets Tab, which is where
# the muscle memory for "the other one" already is.
bind S choose-tree -Zs
bind Tab last-window
bind L last-window
# `x` is deliberately unconfirmed, mirroring CloseCurrentPane({confirm = false})
# in wezterm.lua. This is the same kill with the prompt tmux ships by default,
# for the pane you are less sure about.
bind X confirm-before -p "kill-pane #P? (y/n)" kill-pane


# Enable mouse control (clickable windows, panes, resizable panes)
set -g mouse on
set -g default-terminal "tmux-256color"

# Status bar — Hacktober palette (mirrors WezTerm tab bar)
set -g status-style bg=#141414,fg=#c9c9c9
set -g window-status-style bg=#191918,fg=#c9c9c9
set -g window-status-current-style bg=#c75a22,fg=#141414,bold
# A window is drawn the way WezTerm draws a tab: " <index> <bar><name> ".
#
# A window running claude is named after the agent ("counter-fe"), the same
# identifier `gwt` lists and the WezTerm tab shows, so a window can be matched to
# a row of that listing; #{window_name} is only "claude" for every agent alike.
# Anything else keeps the name tmux picked, and either is truncated to the width
# WezTerm truncates a tab title to. tmux expands #() per window, with that
# window's own #{pane_pid}, and caches each job by command string.
#
# The index is a navigation aid rather than content, so it is painted at low
# contrast against whichever chip it sits on. The bar beside it is the session's
# state, and comes back from the script already carrying its own #[fg=] — a job's
# output is expanded as a format, so a style inside it applies. A window with no
# claude session in it produces no bar, leaving the index against the name as
# before. Both styles have to hand the name its own colours back afterwards,
# since window-status-style is what they overrode to get here.
set -g window-status-format ' #[fg=#464444,nobold]#I #(~/.local/bin/claude-pane-session status "#{pane_pid}")#[fg=#c9c9c9,nobold]#{=24:#(~/.local/bin/claude-pane-session name "#{pane_pid}" "#{window_name}")} '
set -g window-status-current-format ' #[fg=#6d371b,nobold]#I #(~/.local/bin/claude-pane-session status-current "#{pane_pid}")#[fg=#141414,bold]#{=24:#(~/.local/bin/claude-pane-session name "#{pane_pid}" "#{window_name}")} '
set -g window-status-separator ""

# Pane borders: active uses Hacktober orange to match WezTerm focus highlight
set -g pane-active-border-style fg=#c75a22
set -g pane-border-style fg=#464444

set -g status-position top
# Single writer for the session cache the per-window name lookups read. tmux
# expands status-left once per tick, against N times for the window list, so
# putting the one ps snapshot and jq pass here keeps each window's lookup down to
# an awk over the cache. It prints nothing, and the leader chip follows it.
#
# The leader chip mirrors WezTerm's, rendering ⌃a (U+2303 UP ARROWHEAD, matching
# the C-a prefix set at the top of this file). #{?client_prefix,…} picks the
# style: orange #c75a22 on #141414 and bold while the prefix is armed, the tab
# bar's hover grey #464444 on the bar's own #141414 otherwise. The chip holds a
# constant width in both states and signals by colour alone, so arming the
# prefix does not shift the window list sideways. tmux repaints the status line
# as soon as the prefix state changes, so this needs no polling and does not
# depend on status-interval — verified by attaching a client over a
# pseudo-terminal, writing \x01 to it and decoding the SGR codes off the status
# line before and after. Commas inside the #{?…} branches are escaped as #,
# since a bare comma there would end the branch.
set -g status-left-length 20
set -g status-left '#(~/.local/bin/claude-pane-session refresh)#{?client_prefix,#[bg=#c75a22#,fg=#141414#,bold],#[bg=#141414#,fg=#464444#,nobold]} ⌃a #[bg=#141414,fg=#c9c9c9,nobold] '
set -g status-right-length 120
# The tick has to keep up with the busy/idle bar on the window chips, which
# WezTerm redraws against a 1s TTL; at the old interval of 5 a session going idle
# could sit stale for five seconds. What stopped it being lowered was the cost:
# cpu.sh, ram.sh and uptime.sh took 238 ms between them per tick, 218 of it the
# blocking `sleep 0.2` inside cpu.sh, and each window costs two more #() jobs on
# top. Folding the three into status.sh and dropping the per-window `find` in
# claude-pane-session took a whole five-window tick from 336 ms +/- 37 to 148 ms
# +/- 61 of wall time, and 339 ms to 287 ms of CPU (hyperfine, 25 runs, jobs
# started in parallel the way tmux starts them, this Mac).
#
# 1 rather than 2 would hold 287 ms of CPU per second, near a third of a core,
# indefinitely and on battery. 2 halves that, and leaves a worst-case lag within
# a second of WezTerm's own TTL, which is what the bar is being matched against.
set -g status-interval 2
# One #() job for all three metrics rather than three. tmux cannot split a job's
# output across fields, so the glyphs and gaps between them moved into the
# script; the host stays here, since tmux already knows it.
set -g status-right "#[bg=#191918,fg=#c9c9c9] 󰒋 #{host_short}  #(~/.config/tmux/status.sh) "

# Do nothing on bell
set -g visual-activity off
set -g visual-bell off
set -g visual-silence off
setw -g monitor-activity off
set -g bell-action none

# Mouse wheel and copy mode enhancements
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'select-pane -t=; copy-mode -e; send-keys -M'"
bind -n WheelDownPane select-pane -t= \; send-keys -M
bind -n C-WheelUpPane select-pane -t= \; copy-mode -e \; send-keys -M
bind -T copy-mode-vi    C-WheelUpPane   send-keys -X halfpage-up
bind -T copy-mode-vi    C-WheelDownPane send-keys -X halfpage-down
bind -T copy-mode-emacs C-WheelUpPane   send-keys -X halfpage-up
bind -T copy-mode-emacs C-WheelDownPane send-keys -X halfpage-down

# Use vim keybindings in copy mode
setw -g mode-keys vi

# Clipboard integration (OS-specific)
bind-key -T copy-mode-vi v send-keys -X begin-selection

{{ if eq .chezmoi.os "darwin" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'pbcopy'
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'pbcopy'
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'pbcopy'
{{ else if eq .chezmoi.os "linux" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel '~/.config/tmux/copy.sh'
{{ end }}

# The four options tmux-sensible sets that this file does not already set for
# itself (escape-time and focus-events are above). They are inlined rather than
# left to the plugin because the plugin had never once been installed: tpm was
# cloned and `install_plugins` never run, so ~/.tmux/plugins held tpm alone and
# history-limit had been sitting at tmux's default of 2000 lines throughout.
#
# aggressive-resize sizes a window to the smallest client actually looking at it
# rather than to the smallest attached to the session, which matters when a phone
# or a second terminal is attached to the same session and not watching this
# window. status-keys emacs is for the command prompt only; copy mode stays vi
# (mode-keys below).
set -g history-limit 50000
setw -g aggressive-resize on
set -g display-time 4000
set -g status-keys emacs

# Plugins. Session persistence, which is the one thing here that genuinely needs
# a plugin: tmux has no save/restore of its own, and dot_zshrc.tmpl auto-attaches
# on every SSH host, so a reboot silently costs the layout on machines that are
# only ever reached through tmux. continuum saves on a timer and restores when
# the server starts; resurrect is the mechanism underneath it, and has to be
# listed first. Capturing pane contents keeps the scrollback that was on screen,
# and the nvim strategy restores sessions written by :mksession.
#
# tpm is only sourced if it is actually there, so a machine that has not been
# provisioned yet gets a working config rather than an error on every source.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-nvim 'session'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
if-shell '[ -f ~/.tmux/plugins/tpm/tpm ]' "run '~/.tmux/plugins/tpm/tpm'"
