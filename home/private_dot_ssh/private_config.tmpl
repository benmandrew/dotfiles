Host emel
	HostName emel
	Port 2222
	User dev

Host github.com
	HostName github.com
	User git

Host *
	IdentityFile ~/.ssh/id_benmandrew
	IdentitiesOnly yes
	AddKeysToAgent yes
{{ if eq .chezmoi.os "darwin" -}}
	UseKeychain yes
{{ end -}}
	ServerAliveInterval 60
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/sockets/%C
	ControlPersist 600
