#!/bin/bash
# forge-stylesheet-hash: {{ include "dot_config/forge/stylesheet/forge/modify_stylesheet.css" | sha256sum }}

set -euo pipefail
{{- if eq .chezmoi.os "linux" }}

# Same headless guards as the input-sources script, which explains them:
# gsettings ships with glib, and without a session bus every write fails to
# commit.
if ! command -v gsettings >/dev/null 2>&1; then
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
    [ -z "${DISPLAY:-}" ] &&
    [ -z "${WAYLAND_DISPLAY:-}" ]; then
    bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
    if [ -S "${bus}" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
    elif command -v gnome-shell >/dev/null 2>&1; then
        echo "${0##*/}: GNOME is installed but no session bus is reachable;" >&2
        echo "  log in to the desktop, then run chezmoi apply again." >&2
        exit 1
    else
        exit 0
    fi
fi

# Set a key only where its schema is installed and new enough to have it:
# color-scheme arrived in GNOME 42, and dash-to-dock, ding and nemo are absent
# outside Ubuntu's desktop. `gsettings range` fails on a missing schema or key.
gset() {
    if gsettings range "$1" "$2" >/dev/null 2>&1; then
        gsettings set "$1" "$2" "$3"
    fi
}

# Appearance. The Yaru accent variants ship with Ubuntu's yaru-theme packages;
# pointing gtk-theme at a missing theme drops GTK 3 back to unstyled Adwaita.
gset org.gnome.desktop.interface color-scheme 'prefer-dark'
if [ -d /usr/share/themes/Yaru-prussiangreen-dark ]; then
    gset org.gnome.desktop.interface gtk-theme 'Yaru-prussiangreen-dark'
fi
if [ -d /usr/share/icons/Yaru-prussiangreen ]; then
    gset org.gnome.desktop.interface icon-theme 'Yaru-prussiangreen'
fi
gset org.gnome.desktop.interface enable-animations false
gset org.gnome.desktop.interface clock-show-weekday true
gset org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close'
gset org.gnome.mutter workspaces-only-on-primary false

# Input and sound.
gset org.gnome.desktop.peripherals.mouse accel-profile 'flat'
gset org.gnome.desktop.sound allow-volume-above-100-percent true

# Never blank, dim or suspend on mains power.
gset org.gnome.desktop.session idle-delay 0
gset org.gnome.desktop.screensaver lock-delay 0
gset org.gnome.settings-daemon.plugins.power idle-dim false
gset org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing'

# Dock.
gset org.gnome.shell.extensions.dash-to-dock dash-max-icon-size 48
gset org.gnome.shell.extensions.dash-to-dock show-mounts false
gset org.gnome.shell.extensions.dash-to-dock show-trash false

# No desktop icons. DING draws the desktop as one invisible NORMAL window per
# monitor, which Forge tiles like any other, so Super+h/j/k/l focused the
# desktop on entering a monitor. Ubuntu's session mode enables DING, so it is
# absent from enabled-extensions; disabled-extensions overrides the session
# mode, and the running shell applies it at once.
ding='ding@rastersoft.com'
if [ -d "/usr/share/gnome-shell/extensions/${ding}" ] &&
    gsettings range org.gnome.shell disabled-extensions >/dev/null 2>&1; then
    disabled="$(gsettings get org.gnome.shell disabled-extensions)"
    case "${disabled}" in
        *"'${ding}'"*) ;;
        '@as []' | '[]') gsettings set org.gnome.shell disabled-extensions "['${ding}']" ;;
        *) gsettings set org.gnome.shell disabled-extensions "${disabled%]}, '${ding}']" ;;
    esac
fi

# Forge tiling with no gaps between windows or at the screen edges. Its schema
# ships inside the extension, not in the system schema directory, so gset
# cannot see it.
forge_schemas="${HOME}/.local/share/gnome-shell/extensions/forge@jmmaranan.com/schemas"
if [ -d "${forge_schemas}" ]; then
    forge() { gsettings --schemadir "${forge_schemas}" set org.gnome.shell.extensions.forge "$@"; }
    forge window-gap-size 0
    # No yellow edge marking where the next window opens.
    forge split-border-toggle false
    # Forge overwrites the managed stylesheet on enable when css-last-update
    # is behind the cssTag in its theme.js, as it is on a fresh install.
    css_tag="$(sed -n 's/.*this\.cssTag = \([0-9]*\);.*/\1/p' "${forge_schemas}/../theme.js")"
    if [ -n "${css_tag}" ]; then
        forge css-last-update "${css_tag}"
    fi
    # Reload the stylesheet in the running shell.
    now="$(date +%s)"
    forge css-updated "${now}"
fi

# Search and privacy.
gset org.gnome.desktop.search-providers disabled "['org.gnome.Characters.desktop', 'org.gnome.seahorse.Application.desktop', 'org.gnome.Software.desktop', 'org.gnome.Calendar.desktop']"
gset org.gnome.system.location enabled false

# File choosers and file manager.
gset org.gtk.Settings.FileChooser show-hidden true
gset org.gtk.Settings.FileChooser sort-directories-first true
gset org.nemo.preferences date-format 'iso'
{{- end }}
